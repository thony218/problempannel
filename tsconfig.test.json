{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "vitest/globals",
      "vite/client",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "node"
    ]
  },
  "include": [
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tests/setup.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts",
    "tests/perf/**/*.ts",
    "vitest.perf.config.ts"
  ]
}
