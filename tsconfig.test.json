{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "node"
    ]
  },
  "include": [
    "tests/**/*.test.ts",
    "tests/setup.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
