{
  "name": "registre-erreurs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "deploy:production": "npm run build:production && wrangler deploy --env production",
    "contract:lint": "redocly lint contracts/openapi.yaml",
    "contract:generate": "openapi-typescript contracts/openapi.yaml -o src/shared/api-types.generated.ts",
    "types:worker": "wrangler types",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker && npm run typecheck:test && npm run typecheck:e2e",
    "test": "vitest run",
    "db:verify": "vitest run tests/integration/db-migrations.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply registre-erreurs-dev --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "db:seed:local": "wrangler d1 execute registre-erreurs-dev --local --file seed/reference.sql && wrangler d1 execute registre-erreurs-dev --local --file seed/dev.sql",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed:local",
    "verify": "npm run contract:lint && npm run contract:generate && npm run types:worker && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.4",
    "jose": "^6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8",
    "zod": "^4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5",
    "@redocly/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "openapi-typescript": "^7",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.36.0",
    "@types/node": "^24",
    "@playwright/test": "^1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260820.1": true
  }
}
